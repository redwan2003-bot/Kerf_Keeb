CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52833_QDAA=y
CONFIG_BOARD_KERF_DONGLE=y

# Enable MPU
CONFIG_ARM_MPU=y

# GPIO
CONFIG_GPIO=y

# Code is placed after the UF2 bootloader's SoftDevice area
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Flash / settings storage
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# No 32.768 kHz crystal fitted (XL1 is grounded): use the internal RC oscillator
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_500PPM=y

# Internal LDO only (no DC/DC inductor on the board): SOC_DCDC_NRF52X stays off.

# UF2 family for nRF52833 (Adafruit bootloader)
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0x621E937A"
