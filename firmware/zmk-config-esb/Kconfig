config KERF_DONGLE_STATUS_LED
    bool "kerf dongle RGB status LED (blue link / green caps / red battery)"
    default y if BOARD_KERF_DONGLE
    depends on ZMK_SPLIT_ROLE_CENTRAL && ZMK_HID_INDICATORS

if KERF_DONGLE_STATUS_LED

config KERF_DONGLE_LOW_BATTERY_PERCENT
    int "Keyboard battery level (%) at or below which the red LED flashes"
    default 15

endif

config LP63_ESB_STATUS_SCREEN
    bool "nice!view status screen for the ESB link (replaces the BLE peripheral widget)"
    default y if ZMK_SPLIT_ESB && ZMK_DISPLAY && !ZMK_SPLIT_ROLE_CENTRAL
    select LV_FONT_MONTSERRAT_12
    select LV_FONT_MONTSERRAT_16
    select LV_USE_LABEL

config KERF_LED_SPLIT
    bool "Split one WS2812 chain into underglow + status pixels"
    default y
    depends on DT_HAS_KERF_LED_STRIP_SPLIT_ENABLED
    select LED_STRIP

config KERF_LED_SPLIT_INIT_PRIORITY
    int "kerf,led-strip-split init priority (after the real strip)"
    default 91
    depends on KERF_LED_SPLIT

config KERF_BATLED
    bool "Battery level on LED9 (green > 50 %, yellow 20-50 %, red < 20 %)"
    default y
    depends on KERF_LED_SPLIT && ZMK_BATTERY_REPORTING

if KERF_BATLED

config KERF_BATLED_SHOW_MS
    int "Minimum time the battery colour stays on after a tap (ms)"
    default 1000

config KERF_BATLED_MAX_MS
    int "Longest the colour stays on while the key is held (ms)"
    default 10000

config KERF_BATLED_BRIGHTNESS
    int "Indicator brightness for green / yellow (1-255)"
    range 1 255
    default 48

config KERF_BATLED_LOW_BRIGHTNESS
    int "Brightness of the red low-battery colour and blinks (1-255)"
    range 1 255
    default 140

config KERF_BATLED_LOW_PERCENT
    int "Blink red when the battery is at or below this level (on battery only)"
    default 10

config KERF_BATLED_LOW_REPEAT_MIN
    int "Minimum minutes between low-battery blinks"
    default 5

endif
