if SHIELD_BYRANTK_LP63

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "ByranTK LP63"

# --- Keyboard-side hardware (not built into the dongle) ---

# EC11 rotary encoder
config EC11
    default y

choice EC11_TRIGGER_MODE
    default EC11_TRIGGER_GLOBAL_THREAD
endchoice

# Battery level is needed on the keyboard for the LED9 indicator
config ZMK_BATTERY_REPORTING
    default y

# 8x WS2812 underglow + LED9 battery indicator on spi1
config ZMK_RGB_UNDERGLOW
    default y

# RGB on/off also switches the LED rail through Q1 (EXT_POWER on D20).
# VCC for the 74HC595 + nice!view is held on by a GPIO hog in the
# nice_nano_v2 overlay, so it is no longer affected.
config ZMK_RGB_UNDERGLOW_EXT_POWER
    default y

# Battery-friendly: lights start off, brightness capped
config ZMK_RGB_UNDERGLOW_ON_START
    default n

config ZMK_RGB_UNDERGLOW_BRT_MAX
    default 60

# Underglow runs only while USB power is present: unplugging turns it off,
# plugging back in restores the previous on/off state. On battery the LED
# rail (B+ through Q1) can drop below the WS2812B-B/W 3.7 V minimum.
config ZMK_RGB_UNDERGLOW_AUTO_OFF_USB
    default y if USB_DEVICE_STACK

endif

if SHIELD_BYRANTK_LP63_DONGLE

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "ByranTK LP63"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
  default 1

config BT_MAX_CONN
  default 6

config BT_MAX_PAIRED
  default 6

# Bump this value needed for concurrent GATT discovery of splits
config BT_L2CAP_TX_BUF_COUNT
    default 10 if ZMK_SPLIT_ROLE_CENTRAL

endif

if SHIELD_BYRANTK_LP63_ESB_DONGLE

config ZMK_KEYBOARD_NAME
    default "ByranTK LP63"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

# --- Pinctrl Kconfig for part "unibody" ---
if BOARD_NICE_NANO && SHIELD_BYRANTK_LP63

config SPI
    default y


endif
